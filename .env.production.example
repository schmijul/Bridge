# Bridge production configuration template
# Copy to your deployment secret store or environment manager.
# Any line marked with "# SECRET" must be treated as sensitive.

# Server core
PORT=4000
CORS_ORIGIN=https://app.example.com
AUTH_MODE=local
STORE_DRIVER=postgres
POSTGRES_PASSWORD=replace-with-postgres-password # SECRET
REDIS_PASSWORD=replace-with-redis-password # SECRET
DATABASE_URL=postgres://bridge:replace-with-postgres-password@postgres:5432/bridge # SECRET
REDIS_URL=redis://:replace-with-redis-password@redis:6379
RUN_MIGRATIONS_ON_BOOT=true
SEED_DEFAULT_PASSWORDS=false
SHUTDOWN_TIMEOUT_MS=10000

# Sessions, cookies, and proxy
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=.example.com
TRUST_PROXY_HEADERS=true
CSRF_PROTECTION_ENABLED=true

# Login/API/WebSocket rate limits
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=300000
AUTH_LOGIN_FAILURE_LIMIT_MAX=6
AUTH_LOGIN_FAILURE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=180
API_RATE_LIMIT_WINDOW_MS=60000
WS_MESSAGE_RATE_LIMIT_MAX=60
WS_MESSAGE_RATE_LIMIT_WINDOW_MS=10000

# OIDC proxy mode (only used when AUTH_MODE=oidc)
OIDC_PROXY_SECRET=replace-with-random-32-bytes # SECRET
OIDC_PROXY_SECRET_HEADER=x-proxy-secret
OIDC_EMAIL_HEADER=x-auth-request-email
OIDC_DISPLAY_NAME_HEADER=x-auth-request-name
OIDC_GROUPS_HEADER=x-auth-request-groups
OIDC_ROLE_GROUP_ADMIN=bridge-admins
OIDC_ROLE_GROUP_MANAGER=bridge-managers
OIDC_ROLE_GROUP_MEMBER=bridge-members
OIDC_ROLE_GROUP_GUEST=bridge-guests

# Attachment storage
ATTACHMENT_STORAGE_DRIVER=s3
ATTACHMENT_LOCAL_DIR=/var/lib/bridge/uploads
ATTACHMENT_MAX_SIZE_BYTES=26214400
ATTACHMENT_BLOCKED_EXTENSIONS=bat,cmd,com,cpl,exe,js,mjs,cjs,msi,ps1,scr,sh,vbs

# Attachment encryption
ATTACHMENT_ENCRYPTION_PRIMARY_KEY=replace-with-32-byte-base64-or-hex-key # SECRET
ATTACHMENT_ENCRYPTION_PRIMARY_KEY_ID=2026-04
ATTACHMENT_ENCRYPTION_FALLBACK_KEYS=
ATTACHMENT_ENCRYPTION_KEY=

# Attachment malware scanning
ATTACHMENT_SCAN_MODE=command
ATTACHMENT_SCAN_COMMAND=clamscan --no-summary {file}
ATTACHMENT_SCAN_TIMEOUT_MS=10000

# S3 storage backend
ATTACHMENT_S3_BUCKET=bridge-prod-attachments
ATTACHMENT_S3_ACCESS_KEY_ID=replace-me # SECRET
ATTACHMENT_S3_SECRET_ACCESS_KEY=replace-me # SECRET
ATTACHMENT_S3_REGION=us-east-1
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_KEY_PREFIX=bridge/uploads
ATTACHMENT_S3_FORCE_PATH_STYLE=false

# WebDAV backend (only if ATTACHMENT_STORAGE_DRIVER=webdav)
ATTACHMENT_WEBDAV_BASE_URL=https://cloud.example.com/remote.php/dav/files/bridge/
ATTACHMENT_WEBDAV_USERNAME=bridge-bot
ATTACHMENT_WEBDAV_APP_PASSWORD=replace-me # SECRET
ATTACHMENT_WEBDAV_PATH_PREFIX=bridge/attachments
ATTACHMENT_WEBDAV_ALLOW_INSECURE=false

# Push delivery worker
PUSH_DELIVERY_ENABLED=false
PUSH_DELIVERY_PROVIDER=webhook
PUSH_DELIVERY_WEBHOOK_URL=https://push-gateway.example.com/bridge/events
PUSH_DELIVERY_WEBHOOK_AUTH_HEADER=Bearer replace-me # SECRET
PUSH_DELIVERY_POLL_INTERVAL_MS=3000
PUSH_DELIVERY_BATCH_SIZE=20
PUSH_DELIVERY_MAX_ATTEMPTS=5
PUSH_DELIVERY_RETRY_BASE_MS=5000
PUSH_DELIVERY_RETRY_MAX_MS=300000

# Ops endpoints
OPS_BEARER_TOKEN=replace-with-ops-token # SECRET

# Web build-time variables
VITE_API_URL=https://api.example.com
VITE_WS_URL=wss://api.example.com

# Mobile Expo runtime config
API_URL=https://api.example.com
WS_URL=wss://api.example.com

# Desktop shell config
BRIDGE_DESKTOP_URL=https://app.example.com
BRIDGE_WEB_URL=https://app.example.com
BRIDGE_DESKTOP_CLOSE_TO_TRAY=true
BRIDGE_DESKTOP_START_HIDDEN=false
