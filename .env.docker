# Infrastructure credentials (local docker defaults)
POSTGRES_PASSWORD=bridge-dev-only
REDIS_PASSWORD=

# Server runtime
PORT=4000
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
AUTH_MODE=local
STORE_DRIVER=postgres
DATABASE_URL=postgres://bridge:bridge-dev-only@postgres:5432/bridge
REDIS_URL=redis://redis:6379
RUN_MIGRATIONS_ON_BOOT=true
SEED_DEFAULT_PASSWORDS=true
SHUTDOWN_TIMEOUT_MS=10000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=false
CSRF_PROTECTION_ENABLED=true

# Attachments
ATTACHMENT_STORAGE_DRIVER=local
ATTACHMENT_LOCAL_DIR=/app/.bridge_uploads
ATTACHMENT_MAX_SIZE_BYTES=26214400
ATTACHMENT_SCAN_MODE=none

# Web image build args
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
